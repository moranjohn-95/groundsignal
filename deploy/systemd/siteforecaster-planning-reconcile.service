[Unit]
Description=SiteForecaster planning data reconciliation
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/groundsignal
# Recheck a longer window each day to catch delayed source changes.
ExecStart=/usr/bin/docker compose exec -T api python -m backend.app.commands.planning_sync --days 90

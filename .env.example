POSTGRES_DB=groundsignal
POSTGRES_USER=groundsignal
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional alternative to the individual POSTGRES_* settings above:
# DATABASE_URL=postgresql+psycopg://groundsignal:change-me@localhost:5432/groundsignal

# Server-side Google Maps Geocoding API credential:
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

# Local HTTP account development. Production must use production/true and its HTTPS origin.
APP_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
